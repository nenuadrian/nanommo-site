# proto-file: content/quests.proto
# proto-message: nanommo.quests.Quests

# Givers are NPC kinds: 1 the Guard, 3 the Healer, 4 the Ash Warden. Monsters
# by kind: 1 the Skeleton, 2 the Ash Skeleton, 3 the Crypt Skeleton. Prizes
# are items: 2 the Health Potion, 7 the Ash Buckler, 11 the Leather Boots.

quests {
  id: 1
  name: "Bones by the Gate"
  giver: 1
  text: "Skeletons climb out of the ground around the gate, and they don't stay down for long. Put three of them back, and I'll see you're paid for it."
  kill { monster: 1 count: 3 }
  experience: 150
  prizes { item: 2 count: 2 }
}

quests {
  id: 2
  name: "Ash and Bone"
  giver: 4
  text: "The lava keeps something burning in the bones out here. Five Ash Skeletons, and the Ashlands owe you a shield."
  kill { monster: 2 count: 5 }
  experience: 400
  prizes { item: 7 count: 1 }
}

quests {
  id: 3
  name: "Rest for the Crypt"
  giver: 3
  text: "Whoever was buried in the Crypt deserves to rest. Four of its skeletons, and I'll make sure you have something to drink on the way back."
  kill { monster: 3 count: 4 }
  experience: 600
  prizes { item: 2 count: 3 }
}
# proto-file: content/rig.proto
# proto-message: nanommo.rig.Rig

# The skeleton every person is built on, about 1.8 metres tall, standing with
# its arms out to the sides: the hips, which carry the rest, three joints up
# the spine, then the neck and the head, and on each side the collarbone, the
# shoulder, the elbow and the wrist, and the hip, the knee, the ankle, the ball
# of the foot and the tip of the toes. The lengths are an adult's, as shares of
# their height: the leg from the hip to the ankle nearly a half, and the arm to
# the wrist under a third.
joints {
  name: "Hips"
  at { y: 1.0 }
}
joints {
  name: "Spine"
  parent: "Hips"
  at { y: 1.1 }
}
joints {
  name: "Spine1"
  parent: "Spine"
  at { y: 1.21 z: -0.01 }
}
joints {
  name: "Spine2"
  parent: "Spine1"
  at { y: 1.32 z: -0.02 }
}
joints {
  name: "Neck"
  parent: "Spine2"
  at { y: 1.48 z: -0.03 }
}
joints {
  name: "Head"
  parent: "Neck"
  at { y: 1.58 z: -0.01 }
}
joints {
  name: "LeftShoulder"
  parent: "Spine2"
  at { x: 0.05 y: 1.43 z: -0.03 }
  mirrored: true
}
joints {
  name: "LeftArm"
  parent: "LeftShoulder"
  at { x: 0.16 y: 1.42 z: -0.05 }
  mirrored: true
}
joints {
  name: "LeftForeArm"
  parent: "LeftArm"
  at { x: 0.45 y: 1.42 z: -0.05 }
  mirrored: true
}
joints {
  name: "LeftHand"
  parent: "LeftForeArm"
  at { x: 0.72 y: 1.42 z: -0.05 }
  mirrored: true
}
joints {
  name: "LeftUpLeg"
  parent: "Hips"
  at { x: 0.09 y: 0.95 }
  mirrored: true
}
joints {
  name: "LeftLeg"
  parent: "LeftUpLeg"
  at { x: 0.09 y: 0.52 z: 0.01 }
  mirrored: true
}
joints {
  name: "LeftFoot"
  parent: "LeftLeg"
  at { x: 0.09 y: 0.08 z: -0.03 }
  mirrored: true
}
joints {
  name: "LeftToeBase"
  parent: "LeftFoot"
  at { x: 0.09 z: 0.08 }
  mirrored: true
}
joints {
  name: "LeftToe_End"
  parent: "LeftToeBase"
  at { x: 0.09 z: 0.17 }
  mirrored: true
}

# Two builds: the rig as it is, and one broader at the shoulders, with its hips
# a little wider too.
builds {}
builds {
  shifts {
    joint: "LeftArm"
    by { x: 0.03 }
  }
  shifts {
    joint: "LeftUpLeg"
    by { x: 0.01 }
  }
}

# The arms down by the sides, a little out from the body and bent a little at
# the elbow, and the sword hand turned so the blade points ahead.
stance {
  turns {
    joint: LEFT_ARM
    roll: -78
  }
  turns {
    joint: RIGHT_ARM
    roll: 78
  }
  turns {
    joint: LEFT_FOREARM
    yaw: -22
  }
  turns {
    joint: RIGHT_FOREARM
    yaw: 22
  }
  turns {
    joint: RIGHT_HAND
    pitch: 2
    yaw: -6
    roll: -45
  }
}

# Breathing in and out, and the weight going over to one foot, then back.
idle {
  keys {
    at_ms: 0
    lift: -0.02
  }
  keys {
    at_ms: 1600
    turns {
      joint: CHEST
      pitch: -2
    }
    turns {
      joint: HIPS
      roll: 2
    }
    turns {
      joint: SPINE
      roll: -2
    }
    lift: -0.03
  }
  keys {
    at_ms: 3200
    lift: -0.02
  }
}

walk {
